<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#7bb661">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Level Up Quest</title>
<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600&family=Fredoka:wght@400;600&family=Nunito:wght@500;700&family=Caveat:wght@500;700&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--pap:#f6e7c1;--pap2:#ead6a6;--ink:#4a3318;--mute:#80623b;--wood:#9a6732;--woodd:#5e3b19;--grass:#7bb661;--gold:#e9a825;--ok:#5aa84a;--line:#c9ac72;--bg:#b9d98f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme="dark"]{--pap:#33291f;--pap2:#41342a;--ink:#f3e3c0;--mute:#c4a97a;--wood:#6b4624;--woodd:#2c1c0d;--grass:#3f6f3c;--line:#5b4730;--bg:#1d2d22}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Pixelify Sans",system-ui,sans-serif;font-size:17px;line-height:1.45}
.wrap{max-width:680px;margin:0 auto;padding:14px 14px 96px}
.sky{height:170px;position:relative;overflow:hidden;border:4px solid var(--woodd);border-radius:8px}
.sky>*{position:absolute}
.orb{font-size:36px;top:14px}
.cl{font-size:34px;top:24px;opacity:.85;animation:drift 40s linear infinite}
.cl.b{top:60px;font-size:26px;animation-duration:60s;animation-delay:-25s}
@keyframes drift{from{left:-12%}to{left:105%}}
.ground{left:0;right:0;bottom:0;height:62px;background:var(--grass);border-top:4px solid rgba(0,0,0,.15);display:flex;justify-content:space-around;align-items:flex-end;font-size:30px;padding-bottom:6px}
.hero-c{bottom:34px;left:44%;font-size:44px;display:flex;align-items:flex-end;gap:6px;z-index:2}
#pet{font-size:30px;cursor:pointer;background:none;border:0;padding:4px;box-shadow:none}
.sign,.card{background:var(--pap);border:4px solid var(--woodd);border-radius:8px;box-shadow:0 4px 0 var(--woodd)}
.sign{margin-top:10px;padding:12px}
.row{display:flex;gap:8px;align-items:center}.row>*{flex:1;min-width:0}
.row>.sm{flex:0 0 58px;text-align:center}
.g{font-size:21px;font-weight:600}
.say{background:var(--pap2);border-radius:8px;padding:8px 10px;margin-top:8px;position:relative}
.bar{height:16px;background:var(--pap2);border:3px solid var(--woodd);border-radius:4px;overflow:hidden;margin-top:6px}
.fill{height:100%;background:var(--ok);width:0;transition:width .5s}
.meta{display:flex;justify-content:space-between;font-size:14px;color:var(--mute)}
.stats{display:flex;gap:8px;margin-top:10px}
.stat{flex:1;background:var(--pap2);border-radius:6px;padding:6px;text-align:center}
.stat small{display:block;color:var(--mute);font-size:13px}
h2{margin:22px 0 8px;font-size:17px;font-weight:600;display:inline-block;background:var(--wood);color:#fff4d6;padding:4px 14px;border:3px solid var(--woodd);border-radius:6px}
.note{color:var(--mute);font-size:15px;margin:0 0 8px}
.board{display:grid;grid-template-columns:repeat(10,1fr);gap:3px;padding:8px;background:var(--grass);border:4px solid var(--woodd);border-radius:8px}
.tile{aspect-ratio:1;border-radius:5px;background:var(--c);opacity:.4;display:grid;place-items:center;font-size:clamp(10px,3vw,16px);padding:0;border:2px solid rgba(0,0,0,.15);box-shadow:none;color:#3a2a10}
.tile.got{opacity:1}.tile.ms{opacity:1;border-color:var(--gold);border-width:3px}
.tile.me{outline:3px solid #fff;opacity:1;animation:hop 1s infinite alternate}
@keyframes hop{to{transform:translateY(-4px)}}
.zones{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:6px;font-size:14px}
.zones i{display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--c);margin-right:4px}
.plots{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.plot{padding:10px;position:relative;font-size:16px}
.plot .pl{font-size:22px;min-height:30px;letter-spacing:-2px;margin:4px 0}
.plot .x{position:absolute;right:0;top:0}
.add{padding:12px;display:grid;gap:8px}
input,select,button{font:inherit;color:inherit}
input,select{background:var(--pap2);border:3px solid var(--woodd);border-radius:6px;padding:8px;min-width:0;color:var(--ink)}
button{cursor:pointer;border:3px solid var(--woodd);border-radius:6px;padding:8px 12px;font-weight:600;background:var(--ok);color:#fff;box-shadow:0 3px 0 var(--woodd)}
button:active{transform:translateY(2px);box-shadow:0 1px 0 var(--woodd)}
button.alt{background:var(--pap2);color:var(--ink)}
button:disabled{opacity:.55;cursor:default}
:root[data-skin="purple"][data-theme]{--pap:#1c1633;--pap2:#2a2150;--ink:#efe9ff;--mute:#b3a6e6;--wood:#5b34b8;--woodd:#9d7bff;--grass:#241a4a;--gold:#c9a7ff;--ok:#8b5cf6;--line:#4b3a8f;--bg:#0f0a22}
:root[data-skin="blue"][data-theme]{--pap:#0d2b5e;--pap2:#17407f;--ink:#e8f3ff;--mute:#9cc4f0;--wood:#1f5fbf;--woodd:#7fd3ff;--grass:#0d3a78;--gold:#7fe0ff;--ok:#2f8bff;--line:#2f6bb5;--bg:#06142e}
:root[data-skin="ember"][data-theme]{--pap:#2a1210;--pap2:#3d1c18;--ink:#ffe9e0;--mute:#e0a898;--wood:#a52a1f;--woodd:#ff6a4d;--grass:#3a1815;--gold:#ffb347;--ok:#e8452c;--line:#6b2c24;--bg:#14090a}
:root[data-skin]:not([data-skin="cozy"]) .sign,:root[data-skin]:not([data-skin="cozy"]) .card{box-shadow:0 0 14px var(--woodd),inset 0 0 12px rgba(255,255,255,.05)}
:root[data-skin]:not([data-skin="cozy"]) h2{text-transform:uppercase;letter-spacing:.08em}
:root[data-skin]:not([data-skin="cozy"]) .sky{background:radial-gradient(circle at 50% 45%,var(--line),var(--bg) 75%)!important}
:root[data-skin]:not([data-skin="cozy"]) :is(.ground,.cl,.orb){display:none}
:root[data-skin]:not([data-skin="cozy"]) .hero-c{bottom:50px}
.st{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
#stats{flex:1;min-width:190px}
.srow{display:grid;grid-template-columns:1fr auto auto auto;gap:8px;align-items:center;padding:4px 0}
.srow button{padding:2px 10px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:6px}
.cal i{aspect-ratio:1;border-radius:4px;border:2px solid var(--line);display:block}
#pet{margin-left:0;transition:margin-left 1.8s linear}
#pet canvas{display:block;image-rendering:pixelated;filter:drop-shadow(0 4px 0 rgba(0,0,0,.25))}
#pet canvas.step{animation:step .3s steps(2) infinite}
#pet canvas.zz{transform:scaleY(.75) translateY(6px);filter:drop-shadow(0 4px 0 rgba(0,0,0,.25)) brightness(.8)}
@keyframes step{50%{transform:translateY(-4px)}}
.ball{position:absolute;font-size:24px;bottom:40px;z-index:3;animation:drop .6s ease-in}
@keyframes drop{from{transform:translateY(-120px)}}
textarea{background:var(--pap2);border:3px solid var(--woodd);border-radius:6px;padding:8px;color:var(--ink);font:inherit;width:100%}
.nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:var(--pap);border-top:4px solid var(--woodd);padding-bottom:env(safe-area-inset-bottom,0px);z-index:15}
.nav button{flex:1;border:0;border-radius:0;background:none;color:var(--ink);box-shadow:none;font-size:13px;line-height:1.25;padding:8px 0}
.nav button.on{background:var(--pap2);color:var(--ok)}
#pet{display:none!important}
#onb{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:40;display:grid;place-items:center;padding:16px;overflow:auto}
#onb .card{max-width:420px;width:100%;padding:16px}
#onb .opt{display:block;width:100%;margin:8px 0;text-align:left}
#park{left:0;top:0;width:100%;height:100%;image-rendering:pixelated;touch-action:pan-y;z-index:3;cursor:pointer}
.hero-c{display:none!important}
.sky{height:auto;aspect-ratio:16/9}
.sky .ground,.sky .cl,.sky .orb{display:none}
#world{left:0;top:0;width:100%;height:100%;image-rendering:pixelated;z-index:0}
.mbtn{right:8px;top:8px;z-index:4;padding:4px 8px;font-size:18px}
[hidden]{display:none!important}
#pet{animation:idle 2.4s ease-in-out infinite}
#pet.jump{animation:jump .5s}
@keyframes idle{50%{transform:translateY(-3px)}}
@keyframes jump{40%{transform:translateY(-16px) scale(1.15)}}
.fx{position:fixed;font-size:24px;pointer-events:none;z-index:30;animation:fly 1.4s ease-out forwards}
@keyframes fly{to{transform:translate(var(--dx),-220px) rotate(var(--r));opacity:0}}
.br{display:flex;gap:4px;margin-top:8px;align-items:center}
.nd{flex:1;aspect-ratio:1;max-width:36px;border-radius:50%;background:var(--pap2);border:3px solid var(--line);display:grid;place-items:center;font-size:13px;color:var(--mute)}
.nd.on{background:var(--c);border-color:var(--woodd);color:#fff}
.nd.nx{border-color:var(--c);animation:hop 1s infinite alternate}
.nd.ms{border-radius:8px}
.wk{display:flex;gap:6px;align-items:flex-end;height:100px;margin-top:6px}
.wk div{flex:1;text-align:center;font-size:13px;color:var(--mute)}
.wk b{display:block;background:var(--ok);border-radius:4px 4px 0 0;min-height:3px}
.chips{display:flex;flex-wrap:wrap;gap:6px}.chips button{padding:4px 10px;font-size:15px}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.quest{display:flex;gap:8px;align-items:center;padding:8px 10px;margin-bottom:8px;border-left:10px solid var(--c)}
.quest.side{border-style:dashed;border-left-style:solid}
.quest .t{flex:1;min-width:0;overflow-wrap:anywhere}
.quest .t small{display:block;color:var(--mute);font-size:14px}
.x{background:none;border:0;color:var(--mute);box-shadow:none;padding:4px 8px}
.empty{color:var(--mute);text-align:center;padding:14px;border:3px dashed var(--line);border-radius:8px}
.chk{display:flex;gap:8px;align-items:center}
.chk input{width:20px;height:20px;padding:0}
#fire{font-size:30px;text-align:center}
.log{margin:0;padding-left:20px;color:var(--mute)}
details.card{margin-top:22px;padding:10px 12px}
summary{cursor:pointer;font-weight:600}
.set{display:grid;gap:10px;margin-top:10px}
.set label{display:grid;gap:4px}
#toast{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 16px);transform:translate(-50%,-170%);background:var(--gold);color:#3a2700;padding:12px 18px;border:4px solid var(--woodd);border-radius:8px;text-align:center;font-weight:600;transition:transform .35s;z-index:20;max-width:92%}
#toast.show{transform:translate(-50%,0)}
.foot{margin-top:22px;text-align:right}
.calm *{animation:none!important;transition:none!important}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="toast" role="status" aria-live="polite"></div>
<div class="wrap">
  <div class="pg" id="p-home"><div class="sky" id="sky"><canvas id="world" width="480" height="270" aria-hidden="true"></canvas><button class="mbtn alt" id="mus2" aria-label="Toggle music">🔊</button>
    <div class="orb" id="orb"></div><div class="cl">☁️</div><div class="cl b">☁️</div>
    <canvas id="park" aria-label="Your pet. Tap to pet it, drag to carry it, tap the ground to call it"></canvas><div class="ground"><span>🌲</span><span>🏡</span><span>🌻</span><span>🌳</span><span>🐔</span></div>
    <div class="hero-c"><span id="av">🧑‍🌾</span><button id="pet" aria-label="Pet your companion">🐱</button></div>
  </div>
  <div class="sign">
    <div class="row"><div class="g" id="greet"></div><div id="clock" style="text-align:right;flex:0 0 auto"></div></div>
    <p class="note" style="margin:6px 0 0">Tap the ground to walk. Tap yourself for a special move, your pet to pet it, or things in the world to use them. On a computer: click the scene, then arrows or WASD, Space to jump, E to act.</p><div class="say" id="say"></div><div class="row" style="margin-top:8px"><div><div class="meta"><span id="mood"></span><span id="food"></span></div><div class="bar" style="margin-top:2px"><div class="fill" id="mbar" style="background:#e8736c"></div></div></div><button id="play" style="flex:0 0 auto">🎾 Play</button><button id="feed" style="flex:0 0 auto">🍎 Feed</button></div>
    <div class="row" style="margin-top:10px"><b id="lv"></b><span id="ttl" style="text-align:right;color:var(--mute)"></span></div>
    <div class="bar"><div class="fill" id="xpf"></div></div>
    <div class="meta"><span id="xpt"></span><span id="xpn"></span></div>
    <div class="stats">
      <div class="stat"><span id="days">0</span> 🏡<small>days played</small></div>
      <div class="stat"><span id="today">0</span> ✨<small>wins today</small></div>
      <div class="stat"><span id="total">0</span> ⭐<small>total XP</small></div>
    </div>
  </div>

  <div class="card add" style="margin-top:12px"><div id="quote"></div><div id="fact" class="say"></div><div class="row"><button class="alt" id="nf">💡 Another fun fact</button><button class="alt" id="nm">💬 Motivate me</button></div><div class="row"><button id="gift"></button><button id="dly"></button></div></div>
  <h2>Today’s adventures</h2>
  <div class="card add">
    <input id="qt" placeholder="What would you like to try? e.g. Build a to-do app" maxlength="80" aria-label="Quest name">
    <div class="row">
      <select id="qk" aria-label="Skill garden"></select>
      <select id="qs" aria-label="Quest size">
        <option value="10">Tiny · 5 min · 10 XP</option>
        <option value="25" selected>Medium · 20 min · 25 XP</option>
        <option value="50">Big · 1 hr+ · 50 XP</option><option value="100">Epic · half a day · 100 XP</option>
      </select>
    </div>
    <label class="chk"><input type="checkbox" id="qside"> Side quest (just for fun, +50% XP)</label>
    <label>Deadline for a +50% bonus (optional)<input type="datetime-local" id="qd"></label>
    <div class="row"><button id="addb">Add quest</button><button class="alt" id="tiny">Give me a tiny one</button><button class="alt" id="surp">🎲 Surprise me</button></div>
  </div>
  <p class="note" style="margin-top:10px" id="luckn"></p>
  <div id="main"></div>
  <h2>Side quests</h2>
  <div id="side"></div>

  </div><div class="pg" id="p-camp" hidden><h2>Campfire</h2>
  <div class="card add">
    <p class="note" style="margin:0">Sit by the fire and do one thing. Stop any time, nothing is lost.</p>
    <div id="fire">🔥</div>
    <div class="row"><select id="ck" aria-label="Skill garden for campfire"></select></div>
    <div class="row"><button class="alt" data-m="5">5 min</button><button class="alt" data-m="15">15 min</button><button class="alt" data-m="25">25 min</button><button class="alt" data-m="25" data-p="1">🍅 Pomodoro</button><button class="alt" id="stopf">Stop</button></div><div class="row"><span id="sw" style="font-size:22px">⏱ 00:00</span><button class="alt" id="swb">Start</button><button class="alt" id="swr">Reset</button></div>
  </div>

  </div><div class="pg" id="p-garden" hidden><h2>Your garden</h2>
  <div class="plots" id="plots"></div>
  <div class="card add" style="margin-top:8px">
    <div class="row"><input class="sm" id="te" value="🎯" maxlength="2" aria-label="Emoji"><input id="tn" placeholder="New garden, e.g. Coding" maxlength="24" aria-label="Garden name" style="flex:1"><button id="tadd" style="flex:0 0 auto">Plant</button></div>
    <div class="chips" id="chips"></div>
  </div>

  </div><div class="pg" id="p-prog" hidden><h2>Status</h2>
  <div class="card" style="padding:10px"><b id="spt"></b><p class="note" style="margin:2px 0 8px">Spend skill points to boost a skill: +10% XP each, up to 5 per skill. You earn 1 point every level.</p><div class="st"><div id="radar"></div><div id="stats"></div></div></div>
  <h2>Skill map</h2>
  <div class="card" style="padding:10px"><div id="hex"></div></div>
  <h2>Skill branches</h2>
  <div id="branches"></div>
  <div class="card" style="padding:10px"><div>Wins this week</div><div class="wk" id="wk"></div></div>
  <div class="card" style="padding:10px;margin-top:8px"><div>Last 5 weeks</div><div class="cal" id="cal"></div></div>
  </div><div class="pg" id="p-journey" hidden><h2>Your journey</h2>
  <div class="row" style="flex-wrap:wrap;margin-bottom:8px"><b id="jlv"></b><span id="jgd"></span><span id="jbm"></span></div>
  <canvas id="jmap" width="480" height="270" style="width:100%;height:auto;display:block;image-rendering:pixelated;border:4px solid var(--woodd);border-radius:8px;background:#222" aria-label="Your journey map"></canvas>
  <div class="card" id="jenc" style="padding:10px;margin-top:8px"></div>
  <h2>Items</h2>
  <div class="card" style="padding:10px"><div class="chips" id="jinv"></div><p class="note" id="jbon" style="margin:8px 0 0"></p></div>
  <h2>Shop</h2>
  <div class="card" style="padding:10px"><div class="chips" id="jshop"></div></div>
  <h2>Adventure log</h2>
  <ol class="log" id="jlog"></ol>
  <div hidden>
  <p class="note" id="bnote"></p>
  <div class="board" id="board"></div>
  <div class="card add" id="rw" hidden style="margin-top:8px"><span id="rwt"></span><div class="row"><input id="rwi" maxlength="40" placeholder="a nice meal, a new game…" aria-label="Reward"><button id="rws" style="flex:0 0 auto">Save</button></div></div>
  <div class="zones" id="zones"></div></div>

  <h2>Recent wins</h2>
  <ol class="log" id="log"></ol>

  </div><div class="pg" id="p-more" hidden><details class="card" open>
    <summary>⚙️ Settings</summary>
    <div class="set">
      <label>Your name<input id="sn" maxlength="16"></label>
      <label>Font<select id="sf"><option value="'Pixelify Sans'">Pixel</option><option value="Fredoka">Round and cozy</option><option value="Nunito">Clean</option><option value="Caveat">Handwritten</option><option value="Rajdhani">System (techy)</option></select></label>
      <label>Look<select id="skn"><option value="cozy">Cozy village</option><option value="purple">Hunter purple</option><option value="blue">System blue</option><option value="ember">Ember red</option></select></label>
      <label>Character<select id="chr"><option value="ninja">Ninja</option><option value="student">Student</option><option value="wizard">Wizard</option><option value="assassin">Assassin</option><option value="adventurer">Adventurer</option><option value="king">King</option><option value="queen">Queen</option><option value="astronaut">Astronaut</option><option value="nerd">Nerd</option><option value="gamer">Gamer</option><option value="elf">Elf</option><option value="tamer">Tamer</option></select></label>
      <label>Character size<select id="czm"><option value="auto">Auto</option><option value="1">Small</option><option value="2">Large</option></select></label>
      <label class="chk"><input type="checkbox" id="sh"> Challenge mode (missed deadlines have consequences)</label>
      <label>Difficulty (you can change it once more)<select id="dif"><option value="gentle">Gentle</option><option value="standard">Standard</option><option value="hard">Hard</option></select></label>
      <label>If a deadline is missed<select id="jmd"><option value="stay">Stay put (gentle)</option><option value="back1">Go back 1 level</option><option value="cp">Return to last checkpoint</option></select></label>
      <label>Check-in reminder<select id="sr"><option value="0">Off</option><option value="30">Every 30 min</option><option value="60">Every hour</option><option value="120">Every 2 hours</option></select></label>
      <label>Companion<select id="sp"><option value="px:cat">Cat</option><option value="px:dog">Dog</option><option value="px:rabbit">Rabbit</option><option value="px:fox">Fox</option><option value="px:frog">Frog</option><option value="px:penguin">Penguin</option><option value="px:duck">Duck</option><option value="px:bird">Bird</option><option value="px:raven">Raven</option><option value="px:bear">Bear</option><option value="px:lion">Lion</option><option value="px:tiger">Tiger</option><option value="px:dragon">Dragon</option><option value="px:snake">Snake</option></select></label>
      <label>World scene<select id="wsc"><option value="village">Village</option><option value="valley">Valley</option><option value="mountains">Mountains</option><option value="city">City</option><option value="house">House</option><option value="bedroom">Bedroom</option></select></label>
      <label>Season<select id="wse"><option value="spring">Spring</option><option value="summer">Summer</option><option value="autumn">Autumn</option><option value="winter">Winter</option></select></label>
      <label>Weather<select id="wwx"><option value="clear">Clear</option><option value="cloudy">Cloudy</option><option value="rain">Rain</option><option value="snow">Snow</option><option value="storm">Storm</option><option value="fog">Fog</option></select></label>
      <label>World mood<select id="wmo"><option value="normal">Normal</option><option value="cozy">Cozy</option><option value="dreamy">Dreamy</option><option value="spooky">Spooky</option><option value="gloomy">Gloomy</option></select></label>
